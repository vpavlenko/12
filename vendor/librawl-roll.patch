+/* Caplin's baseline, figured-bass stacks, and dark score colors. */
+.rawln-roman {
+  display: inline;
+  position: relative;
+  white-space: nowrap;
+  font-family: Georgia, "Times New Roman", serif;
+  font-style: normal;
+  font-weight: 400;
+  line-height: 0;
+  vertical-align: baseline;
+}
+.rawln-roman sup { display: inline-block; position: relative; top: -.5em; vertical-align: baseline; font-size: .64em; line-height: 0; margin-left: .025em; }
+.rawln-roman .figures { display: inline-block; position: relative; vertical-align: baseline; height: 0; width: .58em; font-size: .64em; line-height: 0; margin-left: .04em; text-align: left; }
+.rawln-roman .figures > span { position: absolute; left: 0; line-height: 1; white-space: nowrap; }
+.rawln-roman .figures > span:first-child { top: -1.32em; }
+.rawln-roman .figures > span:nth-of-type(2) { top: -.58em; }
+.rawln-roman .figures.augmented { width: 1.22em; }
+.rawln-roman .figures.quality-figure { width: .66em; }
+.rawln-roman .figures.quality-figure[data-quality="diminished"] { width: .5em; margin-left: 0; }
+.rawln-roman .quality-figure[data-quality="diminished"] + .figures { margin-left: 0; }
+.rawln-roman .figures.quality-figure sup { position: static; font-size: inherit; line-height: inherit; margin: 0; }
+.rawln-roman .chord-root { font-kerning: normal; white-space: nowrap; }
+.rawln-roman .chord-accidental { display: inline-block; margin-left: -.08em; margin-right: -.14em; font-style: normal; }
+.rawln-roman .chord-accidental.sharp { margin-right: -.1em; }
+.rawln-roman[data-roman-font="sans-serif"] { font-family: system-ui, sans-serif; }
+.rawln-roman[data-roman-font="sans-serif"] .chord-root > .chord-accidental:last-child { margin-right: .06em; }
+.rawln-roman .chord-opening-parenthesis { display: inline-block; margin-right: -.075em; }
+.rawln-roman .colored { color: var(--chord-color); paint-order: stroke fill; }
+.rawln-roman .chord-slash { color: #888; }
+.rawln-roman[data-roman-theme="light"] .colored[data-root="0"] { color: #000; }
+.rawln-roman[data-roman-theme="dark"] .colored:is([data-root="1"],[data-root="3"],[data-root="5"],[data-root="8"]) {
+  --rawln-shadow-step: clamp(0px, calc(1px - .045em), .035em);
+  -webkit-text-stroke: clamp(0px, calc(1.8px - .075em), .075em) var(--chord-color);
+  text-shadow:
+    calc(-1 * var(--rawln-shadow-step)) 0 0 var(--chord-color),
+    var(--rawln-shadow-step) 0 0 var(--chord-color),
+    0 calc(-1 * var(--rawln-shadow-step)) 0 var(--chord-color),
+    0 var(--rawln-shadow-step) 0 var(--chord-color),
+    0 0 min(.075em, 1px) var(--chord-color);
+}
+.rawln-roman[data-roman-theme="dark"] .chord-root.colored[data-root="5"] { -webkit-text-stroke: 0; text-shadow: 0 0 min(.12em, 1.25px) var(--chord-color); }
+
+/* Caplin's chord diagram, scoped to the optional shared RN tooltip. */
+.rawln-roman[data-rn-tooltip] {
+  cursor: pointer;
+  pointer-events: auto;
+}
+
+.rawln-roman[data-rn-tooltip]:focus-visible {
+  outline: 1px solid currentColor;
+  outline-offset: 3px;
+  border-radius: 1px;
+}
+
+.rawln-rn-tooltip {
+  position: fixed;
+  z-index: 10000;
+  box-sizing: border-box;
+  width: max-content;
+  max-width: calc(100vw - 16px);
+  max-height: calc(100dvh - 16px);
+  padding: 14px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  pointer-events: auto;
+  background: #000;
+  color: #eee;
+  border: 1px solid #666;
+  border-radius: 5px;
+  box-shadow: 0 4px 16px #0006;
+  font: 13px/1.3 Arial, sans-serif;
+}
+
+.rawln-rn-tooltip-columns {
+  display: flex;
+  justify-content: center;
+  align-items: start;
+  gap: 22px;
+  text-indent: 0;
+}
+
+.rawln-rn-tooltip-column {
+  min-width: 0;
+  text-align: center;
+}
+
+.rawln-rn-tooltip-label {
+  min-height: 40px;
+  padding: 5px 0 4px;
+  color: #fff;
+  font: 28px/1.1 Georgia, 'Times New Roman', serif;
+  white-space: nowrap;
+}
+
+.rawln-rn-tooltip-grid {
+  position: relative;
+  width: 116px;
+  margin: 0 auto 10px;
+}
+
+.rawln-rn-tooltip-guide {
+  position: absolute;
+  left: 0;
+  right: 0;
+  height: 1px;
+  pointer-events: none;
+  background: #fff;
+}
+
+.rawln-rn-tooltip-guide[data-degree="7"] {
+  background: #787878;
+}
+
+.rawln-rn-tooltip-note {
+  position: absolute;
+  left: 12px;
+  width: 60px;
+  height: 12px;
+  border-radius: 6px;
+  color: #000;
+  font: 11px/12px Arial, sans-serif;
+  text-align: center;
+}
+
+.rawln-rn-tooltip-note:is([data-degree="1"], [data-degree="3"], [data-degree="5"], [data-degree="8"]) {
+  color: #fff;
+}
+
+.rawln-rn-tooltip-interval {
+  position: absolute;
+  left: 72px;
+  transform: translateY(-50%);
+  padding: 0 2px;
+  background: #000;
+  color: #ddd;
+  font: 12px/1 Arial, sans-serif;
+}
+
+.rawln-rn-tooltip-kind { font-size: 14px; }
+.rawln-rn-tooltip-inversion { margin-top: 3px; color: #bbb; }
+
+.rawln-rn-tooltip:has(.rawln-rn-explanations) { width: 360px; }
+
+.rawln-rn-explanations {
+  margin: 14px 0 0;
+  padding: 10px 0 0;
+  border-top: 1px solid #333;
+  text-align: left;
+  font: 12px/1.4 Arial, sans-serif;
+}
+
+.rawln-rn-explanations > div {
+  display: grid;
+  grid-template-columns: 48px minmax(0, 1fr);
+  gap: 8px;
+  margin-bottom: 8px;
+}
+
+.rawln-rn-explanations > div:last-child { margin-bottom: 0; }
+
+.rawln-rn-explanations dt {
+  margin: 0;
+  color: #fff;
+  font: 16px/1.2 Georgia, 'Times New Roman', serif;
+  overflow-wrap: anywhere;
+}
+
+.rawln-rn-explanations dd { margin: 0; color: #ddd; text-indent: 0; }
+.rawln-rn-explanations .colored { color: var(--chord-color); }
+
+.rawln-rn-explanations .colored:is([data-root="1"], [data-root="3"], [data-root="5"], [data-root="8"]) {
+  paint-order: stroke fill;
+  -webkit-text-stroke: .075em var(--chord-color);
+  text-shadow: 0 0 .075em var(--chord-color);
+}
+
+.rawln-rn-explanations .chord-root.colored[data-root="5"] {
+  -webkit-text-stroke: 0;
+  text-shadow: 0 0 .12em var(--chord-color);
+}
+
+@media (max-width: 360px) {
+  .rawln-rn-tooltip { padding: 12px 10px; }
+  .rawln-rn-tooltip-columns { gap: 10px; }
+  .rawln-rn-tooltip-grid { width: 106px; }
+  .rawln-rn-tooltip-kind { font-size: 12px; }
+  .rawln-rn-tooltip-inversion { font-size: 11px; }
+}

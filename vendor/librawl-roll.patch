+  [5,'2',true,'red'],[9,'3',true,'#666'],[12,null,true,'#666'],
+ ]);
+ const clipped=measureHeaderLayout({...props,row:{start:5.5,end:12}});
+ assert.deepEqual(clipped.measures.map(({beat})=>beat),[9,12]);
+ const regular=measureHeaderLayout({row:{start:4,end:12},width:800});
+ assert.deepEqual(regular.measures.map(({beat,isPhraseStart})=>[beat,isPhraseStart]),[[4,true],[8,false]]);
+});
diff --git a/tests/piano-legend.test.mjs b/tests/piano-legend.test.mjs
new file mode 100644
index 0000000..43da8f8
--- /dev/null
+++ b/tests/piano-legend.test.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { JSDOM } from 'jsdom';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { FoldablePianoLegend, PianoLegend } from 'librawl/components';
+
+const modes = [{ title: 'major', chords: [
+  { name: 'bII', pitches: [1, 5, 8] },
+  { name: 'V/V', pitches: [2, 6, 9] },
+] }];
+
+function render(Component, props) {
+  return new JSDOM(renderToStaticMarkup(createElement(Component, props))).window.document.body;
+}
+
+function dots(root) {
+  return Array.from(root.querySelectorAll('.rawln-piano-pitch-dot'), dot => ({
+    color: dot.style.background,
+    size: [dot.style.width, dot.style.height],
+    hidden: dot.getAttribute('aria-hidden'),
+  }));
+}
+
+const expected = [
+  { color: 'white', size: ['1px', '1px'], hidden: 'true' },
+  { color: 'black', size: ['2px', '2px'], hidden: 'true' },
+];
+
+test('piano pitch dots match the original marks in both sizes and after transposing', () => {
+  for (const inline of [false, true]) {
+    const keys = render(PianoLegend, { inline, currentTonic: 7 });
+    assert.deepEqual(dots(keys), expected);
+    assert.equal(keys.querySelectorAll('.rawln-piano-key').length, 12);
+    if (!inline) {
+      const labels = [...keys.querySelectorAll('.rawln-piano-key:has(> .rawln-piano-pitch-dot)')]
+        .map(key => key.textContent);
+      assert.deepEqual(labels, ['♭2', '♯4']);
+    }
+  }
+});
+
+test('chord stairs retain both relative pitch dots', t => {
+  const originalStorage = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+  Object.defineProperty(globalThis, 'localStorage', { value: { getItem: () => 'true' }, configurable: true });
+  t.after(() => {
+    if (originalStorage) Object.defineProperty(globalThis, 'localStorage', originalStorage);
+    else delete globalThis.localStorage;
+  });
+  const legend = render(FoldablePianoLegend, { modes, currentTonic: 7 });
+  const chordNotes = legend.querySelector('.rawln-piano-chords');
+  assert.equal(chordNotes.querySelectorAll('.rawln-piano-chord > i').length, 6);
+  assert.deepEqual(dots(chordNotes), expected);
+  assert.equal(legend.querySelector('.rawln-piano-legend').dataset.expanded, 'true');
+});
diff --git a/tests/playback-footer.test.mjs b/tests/playback-footer.test.mjs
new file mode 100644
index 0000000..2efa2af
--- /dev/null
+++ b/tests/playback-footer.test.mjs
@@ -0,0 +1,109 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import React from 'react';
+import {flushSync} from 'react-dom';
+import {createRoot} from 'react-dom/client';
+import {JSDOM} from 'jsdom';
+import {PlaybackFooter} from 'librawl/components';
+
+test('PlaybackFooter keeps musical marks and delegates transport controls to its host', async () => {
+  const {window} = new JSDOM('<div id="root"></div>');
+  globalThis.window = window;
+  globalThis.document = window.document;
+  const element = document.getElementById('root');
+  const root = createRoot(element);
+  let toggles = 0;
+  const rates = [];
+  const volumes = [];
+  const props = {
+    position: 59.99, duration: 100, playing: false,
+    onTogglePlay: () => toggles++, onSeek: () => {},
+    rate: 1, onRateChange: rate => rates.push(rate),
+    volume: 0.75, onVolumeChange: volume => volumes.push(volume),
+    volumeMax: 1.5, keyboardShortcuts: true,
+    timeline: {
+      sections: [20], phrases: [35],
+      bassBars: [{start: -4, end: 40, color: 'red'}],
+    },
+  };
+  try {
+    flushSync(() => root.render(React.createElement(PlaybackFooter, props)));
+    assert.deepEqual([...element.querySelectorAll('.rawlp-time')].map(time => time.textContent), ['0:59','1:40']);
+    assert.deepEqual([...element.querySelectorAll('.rawlp-section-mark')].map(mark => mark.style.left), ['20%','100%']);
+    const bass = element.querySelector('.rawlp-bass-bar');
+    assert.equal(bass.style.left,'0%');
+    assert.equal(bass.style.width,'40%');
+    assert.equal(element.querySelector('[aria-label="Volume"]').max,'150');
+    element.querySelector('[aria-label="Play"]').click();
+    element.querySelector('[aria-label="Speed up"]').click();
+    element.querySelector('[aria-label="Volume"]').dispatchEvent(new window.MouseEvent('dblclick',{bubbles:true}));
+    document.dispatchEvent(new window.KeyboardEvent('keydown',{code:'Space',key:' ',bubbles:true,cancelable:true}));
+    assert.equal(toggles,2);
+    assert.deepEqual(rates,[1.1]);
+    assert.deepEqual(volumes,[1]);
+    flushSync(() => root.render(React.createElement(PlaybackFooter,{...props,position:60,playing:true})));
+    assert.equal(element.querySelector('.rawlp-bass-bar'),bass);
+    assert.equal(element.querySelector('.rawlp-time').textContent,'1:00');
+    assert(element.querySelector('[aria-label="Pause"]'));
+  } finally {
+    flushSync(() => root.unmount());
+    await new Promise(resolve => setTimeout(resolve,20));
+    window.close();
+    delete globalThis.window;
+    delete globalThis.document;
+  }
+});
+
+test('PlaybackFooter follows the live audio clock frame by frame and stops when paused', async () => {
+  const {window} = new JSDOM('<div id="root"></div>');
+  globalThis.window = window;
+  globalThis.document = window.document;
+  const frames = new Map();
+  let frameId = 0;
+  globalThis.requestAnimationFrame = callback => {
+    frames.set(++frameId, callback);
+    return frameId;
+  };
+  globalThis.cancelAnimationFrame = id => frames.delete(id);
+  const element = document.getElementById('root');
+  const root = createRoot(element);
+  let liveTime = 1;
+  const props = {
+    position: 0, duration: 12, playing: true, getPosition: () => liveTime,
+    onTogglePlay: () => {}, onSeek: () => {},
+    timeline: {sections: [4, 8]},
+  };
+  function advance(time) {
+    liveTime = time;
+    assert.equal(frames.size, 1);
+    const [id, callback] = frames.entries().next().value;
+    frames.delete(id);
+    callback();
+  }
+  try {
+    flushSync(() => root.render(React.createElement(PlaybackFooter, props)));
+    const slider = element.querySelector('input[aria-label="Seek"]');
+    const mark = element.querySelector('.rawlp-section-mark');
+    assert.equal(slider.valueAsNumber, 1);
+    advance(1.017);
+    assert.equal(slider.valueAsNumber, 1.017);
+    advance(2.125);
+    assert.equal(slider.valueAsNumber, 2.125);
+    assert.equal(slider.getAttribute('aria-valuetext'), '0:02');
+    assert.equal(element.querySelector('.rawlp-section-mark'), mark);
+    flushSync(() => root.render(React.createElement(PlaybackFooter, {...props, position: 2.2, playing: false})));
+    assert.equal(slider.valueAsNumber, 2.2);
+    assert.equal(frames.size, 0);
+    flushSync(() => root.render(React.createElement(PlaybackFooter, props)));
+    assert.equal(frames.size, 1);
+  } finally {
+    flushSync(() => root.unmount());
+    await new Promise(resolve => setTimeout(resolve,20));
+    window.close();
+    delete globalThis.requestAnimationFrame;
+    delete globalThis.cancelAnimationFrame;
+    delete globalThis.window;
+    delete globalThis.document;
+  }
+  assert.equal(frames.size, 0);
+});
diff --git a/tests/playback-keys.test.mjs b/tests/playback-keys.test.mjs
new file mode 100644
index 0000000..04ba9f6
--- /dev/null
+++ b/tests/playback-keys.test.mjs
@@ -0,0 +1,117 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {JSDOM} from 'jsdom';
+import {bindPlaybackKeys} from '../src/audio/playback-keys.js';
+import {createTransport} from '../src/audio/transport.js';
+
+function keyboard(window) {
+  return (target = window.document.body, init = {}) => {
+    const event = new window.KeyboardEvent('keydown', {
+      key: ' ', bubbles: true, cancelable: true, ...init,
+    });
+    target.dispatchEvent(event);
+    return event.defaultPrevented;
+  };
+}
+
+test('Persistent playback captures Space on links and buttons and honors text entry', () => {
+  const {window} = new JSDOM('<a href="#target">Solo</a><button>Tempo</button><input><textarea></textarea>');
+  const {document} = window;
+  const press = keyboard(window);
+  let count = 0;
+  const app = bindPlaybackKeys({target: document, toggle: () => count++});
+  const [link, button, input, textarea] = document.body.children;
+  button.addEventListener('keydown', () => assert.fail('focused buttons must not handle the captured key'));
+  assert.equal(press(link), true);
+  assert.equal(press(button), true);
+  assert.equal(press(button, {repeat:true}), true);
+  assert.equal(press(input), false);
+  assert.equal(press(textarea), false);
+  assert.equal(count, 2);
+  app.destroy();
+  const all = bindPlaybackKeys({target: document, toggle: () => count++, allowInInputs:true});
+  assert.equal(press(input), true);
+  assert.equal(count, 3);
+  all.destroy();
+  assert.equal(press(link), false);
+  window.close();
+});
+
+test('Space pauses the latest active player and consumes repeats of that press', () => {
+  const {window} = new JSDOM();
+  const target = window.document;
+  const press = keyboard(window);
+  const pauses = [];
+  const first = bindPlaybackKeys({target, pause: () => {
+    pauses.push('first');
+    first.setActive(false);
+  }});
+  const second = bindPlaybackKeys({target, pause: () => {
+    pauses.push('second');
+    second.setActive(false);
+  }});
+  assert.equal(press(), false);
+  first.setActive(true);
+  second.setActive(true);
+  assert.equal(press(), true);
+  assert.equal(press(undefined, {repeat: true}), true);
+  assert.deepEqual(pauses, ['second']);
+  assert.equal(press(), true);
+  assert.deepEqual(pauses, ['second', 'first']);
+  assert.equal(press(undefined, {repeat: true}), true);
+  assert.equal(press(), false);
+  first.destroy();
+  second.destroy();
+  window.close();
+});
+
+test('A reader can suppress idle scrolling without taking Space from focused controls', () => {
+  const {window} = new JSDOM('<input><button><span></span></button><summary></summary>'
+    + '<div contenteditable><strong></strong></div><div role="slider"></div>');
+  const target = window.document;
+  const press = keyboard(window);
+  const binding = bindPlaybackKeys({target, pause: () => assert.fail(), preventScrollWhenIdle: true});
+  assert.equal(press(), true);
+  for (const control of target.querySelectorAll('input, button span, summary, strong, [role="slider"]')) {
+    assert.equal(press(control), false);
+  }
+  for (const options of [{ctrlKey: true}, {metaKey: true}, {altKey: true}, {shiftKey: true}, {isComposing: true}]) {
+    assert.equal(press(undefined, options), false);
+  }
+  const dialog = target.createElement('dialog');
+  dialog.open = true;
+  target.body.append(dialog);
+  assert.equal(press(), false);
+  binding.destroy();
+  dialog.remove();
+  assert.equal(press(), false);
+  window.close();
+});
+
+test('The transport shortcut cancels preparation without starting the engine later', async t => {
+  const {window} = new JSDOM();
+  globalThis.document = window.document;
+  globalThis.cancelAnimationFrame = () => {};
+  t.after(() => {
+    delete globalThis.document;
+    delete globalThis.cancelAnimationFrame;
+    window.close();
+  });
+  const press = keyboard(window);
+  let finishResume;
+  const audio = {
+    getContext: () => ({resume: () => new Promise(resolve => { finishResume = resolve; })}),
+    prepare: () => assert.fail('cancelled preparation must not start'),
+    stop: () => {},
+  };
+  const transport = createTransport({makePlan: () => {}, audio});
+  transport.load({beats: 4, tempo: 120});
+  const play = transport.play();
+  assert.equal(transport.state, 'loading');
+  assert.equal(press(), true);
+  assert.equal(transport.state, 'paused');
+  finishResume();
+  await play;
+  assert.equal(press(), false);
+  transport.destroy();
+});
diff --git a/tests/playback-measure.test.mjs b/tests/playback-measure.test.mjs
new file mode 100644
index 0000000..aed9bb2
--- /dev/null
+++ b/tests/playback-measure.test.mjs
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import React from 'react';
+import {flushSync} from 'react-dom';
+import {createRoot} from 'react-dom/client';
+import {JSDOM} from 'jsdom';
+import {PlaybackMeasureBorders,RawlNotation} from 'librawl';
+import {createSectionPlaybackClock} from 'librawl/native';
+
+function mount(t){
+ const {window}=new JSDOM('<div id="root"></div>');
+ globalThis.window=window;
+ globalThis.document=window.document;
+ const host=document.getElementById('root'),root=createRoot(host);
+ t.after(async()=>{
+  flushSync(()=>root.unmount());
+  await new Promise(resolve=>setTimeout(resolve,20));
+  window.close();
+  delete globalThis.document;
+  delete globalThis.window;
+ });
+ return {
+  host,
+  render:(Component,props)=>flushSync(()=>root.render(React.createElement(Component,props))),
+  active:()=>[...host.querySelectorAll('.rawln-playback-measure:not([hidden])')],
+ };
+}
+
+test('the displayed current measure follows the beat clock across splits, rests and seeks',t=>{
+ const {host,render,active}=mount(t),clock=createSectionPlaybackClock();
+ render(RawlNotation,{notes:[],beats:12,rows:[{start:0,end:6},{start:6,end:12}],phraseStarts:[12],playbackClock:clock});
+ const bar=beat=>host.querySelector(`.rawln-bar[data-beat="${beat}"]`);
+ assert.equal(bar(0).style.left,'0px');
+ assert.equal(bar(0).dataset.phraseBoundary,'true');
+ assert.match(bar(4).style.left,/^calc\(66\.666[^%]*% - 1px\)$/);
+ assert.equal(bar(12).dataset.terminal,'true');
+ assert.equal(bar(12).style.left,'calc(100% - 1px)');
+ assert.equal(active().length,0);
+ const current=(measure,row,width,beginsRow)=>{
+  const [border]=active();
+  assert.equal(active().length,1);
+  assert.equal(border.dataset.measure,String(measure));
+  assert.equal(border.closest('.rawln-row').dataset.start,String(row));
+  const widthPattern=beginsRow?/^([\d.]+)%$/:/^calc\(([\d.]+)% \+ 1px\)$/;
+  const widthParts=widthPattern.exec(border.style.width);
+  if(beginsRow)assert.equal(border.style.left,'0px');
+  else assert.match(border.style.left,/^calc\([\d.]+% - 1px\)$/);
+  assert(widthParts);
+  assert(Math.abs(Number(widthParts[1])-width)<1e-3);
+  assert.equal(border.style.borderTopWidth,'1px');
+  assert.equal(border.style.borderBottomWidth,'1px');
+  assert.equal(border.style.borderTopColor,'rgb(68, 68, 68)');
+  assert.equal(border.style.pointerEvents,'none');
+ };
+ clock.advance(0);
+ current(1,0,4/6*100,true);
+ clock.advance(4);
+ current(2,0,2/6*100,false);
+ clock.advance(6);
+ current(2,6,2/6*100,true);
+ clock.advance(8);
+ current(3,6,4/6*100,false);
+ clock.advance(12);
+ assert.equal(active().length,0);
+ clock.advance(2);
+ current(1,0,4/6*100,true);
+ clock.reset();
+ assert.equal(active().length,0);
+});
+
+test('authored playback intervals follow recording time and repeated overlay passes',t=>{
+ const {render,active}=mount(t),clock=createSectionPlaybackClock();
+ const measureMap=[
+  {start:0,duration:2,sourceNumber:'pickup',playbackSpans:[[10,13],[12,13.5],[50,52]]},
+  {start:2,duration:3,sourceNumber:1,playbackSpans:[[14,20],[52,57]]},
+  {start:5,duration:3,sourceNumber:2,playbackSpans:[]},
+ ];
+ const playing=()=>active().map(el=>[el.dataset.measure,el.closest('.rawln-row').dataset.start]);
+ clock.advance(12.5);
+ render(RawlNotation,{
+  notes:[],beats:8,rows:[{start:0,end:3},{start:3,end:8}],playbackClock:clock,measureMap,
+ });
+ assert.deepEqual(playing(),[['pickup','0']]);
+ clock.advance(13);
+ assert.deepEqual(playing(),[['pickup','0']]);
+ clock.advance(13.5);
+ assert.deepEqual(playing(),[]);
+ clock.advance(14);
+ assert.deepEqual(playing(),[['1','0']]);
+ clock.advance(16);
+ assert.deepEqual(playing(),[['1','3']]);
+ clock.advance(50);
+ assert.deepEqual(playing(),[['pickup','0']]);
+ clock.advance(57);
+ assert.deepEqual(playing(),[]);
+ clock.advance(6);
+ assert.deepEqual(playing(),[]);
+});
+
+test('controlled position and Rawl’s independent edge flags share the visual primitive',t=>{
+ const {render,active}=mount(t);
+ const props={notes:[],beats:8};
+ render(RawlNotation,{...props,position:4});
+ assert.equal(active()[0].dataset.measure,'2');
+ render(RawlNotation,{...props,position:null});
+ assert.equal(active().length,0);
+ render(PlaybackMeasureBorders,{left:23,width:100,top:false});
+ const border=active()[0];
+ assert.equal(border.style.left,'23px');
+ assert.equal(border.style.width,'100px');
+ assert.equal(border.style.borderTopWidth,'');
+ assert.equal(border.style.borderBottomWidth,'1px');
+});
diff --git a/tests/recording-roll.test.mjs b/tests/recording-roll.test.mjs
new file mode 100644
index 0000000..4b6c02a
--- /dev/null
+++ b/tests/recording-roll.test.mjs
@@ -0,0 +1,93 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import React from 'react';
+import {flushSync} from 'react-dom';
+import {createRoot} from 'react-dom/client';
+import {JSDOM} from 'jsdom';
+import {RawlNotation} from 'librawl';
+import {createSectionPlaybackClock} from 'librawl/native';
+
+test('recording intervals drive notes independently of overlapping display beats', async () => {
+  const window = new JSDOM('<div id="root"></div>').window;
+  globalThis.window = window;
+  globalThis.document = window.document;
+  const element = document.getElementById('root');
+  const root = createRoot(element);
+  const clock = createSectionPlaybackClock();
+  const sounding = () => [...element.querySelectorAll('.rawln-sounding')].map(note => [
+    note.dataset.note, note.closest('.rawln-row').dataset.start,
+  ]);
+  const notes = [
+    {id:'first',pitch:60,start:1,duration:2,voice:0,playbackSpan:[10,14]},
+    {id:'later',pitch:62,start:1,duration:2,voice:0,playbackSpan:[20,24]},
+  ];
+  clock.advance(21);
+  try {
+    flushSync(() => root.render(React.createElement(RawlNotation, {
+      notes, beats:4, rows:[{start:0,end:2},{start:2,end:4}], playbackClock:clock,
+      recolorable:false,
+      renderUnderlay:(row,axis) => React.createElement('div', {
+        'data-underlay-top':axis.pitchToY(62),
+      }),
+    })));
+    const note = element.querySelector('[data-note="later"]');
+    assert.equal(note.style.height, '10px');
+    assert.deepEqual(sounding(), [['later','0']]);
+    clock.advance(12);
+    assert.deepEqual(sounding(), [['first','2']]);
+    assert.equal(note.style.height, '5px');
+    assert.equal(element.querySelector('.rawln-score [data-underlay-top]').dataset.underlayTop,'20');
+  } finally {
+    flushSync(() => root.unmount());
+    await new Promise(resolve => setTimeout(resolve,20));
+    window.close();
+    delete globalThis.window;
+    delete globalThis.document;
+  }
+});
+
+test('alignScoreRows aligns the downbeats with equal time scale across pickup and full rows', async () => {
+  const {alignScoreRows} = await import('librawl/geometry');
+  const {rows, width} = alignScoreRows([
+    {start:0,end:52,anchor:4}, {start:52,end:100,anchor:52}, {start:100,end:112},
+  ]);
+  assert.equal(width,52);
+  assert.equal(rows[0].style.width,'100%');
+  const beatPercent = 100 / 52;
+  for (const row of rows.slice(1)) {
+    assert(Math.abs(parseFloat(row.style.marginLeft) - 4 * beatPercent) < 1e-9);
+    assert(Math.abs(parseFloat(row.style.width) - (row.end-row.start) * beatPercent) < 1e-9);
+  }
+});
+
+test('score seeking uses the transport clock while measure recoloring keeps playback in place', async () => {
+  const {window} = new JSDOM('<div id="root"></div>');
+  globalThis.window = window;
+  globalThis.document = window.document;
+  const element = document.getElementById('root');
+  const root = createRoot(element);
+  const seeks = [];
+  const clock = {...createSectionPlaybackClock(), seek: beat => seeks.push(beat)};
+  const notes = [{id:'note',pitch:62,start:1,duration:1,voice:0}];
+  const click = (node, x = 0) => flushSync(() => node.dispatchEvent(
+    new window.MouseEvent('click', {bubbles:true, clientX:x}),
+  ));
+  try {
+    flushSync(() => root.render(React.createElement(RawlNotation, {notes, beats:4, playbackClock:clock})));
+    const score = element.querySelector('.rawln-score');
+    score.getBoundingClientRect = () => ({left:10,width:200});
+    click(score, 110);
+    click(element.querySelector('[data-note="note"]'));
+    assert.deepEqual(seeks,[2,1]);
+    click(element.querySelector('.rawln-measure-number'));
+    click(element.querySelector('[data-note="note"]'));
+    assert.deepEqual(seeks,[2,1]);
+    assert.equal(element.querySelector('[data-note="note"]').dataset.degree,'0');
+  } finally {
+    flushSync(() => root.unmount());
+    await new Promise(resolve => setTimeout(resolve,20));
+    window.close();
+    delete globalThis.window;
+    delete globalThis.document;
+  }
+});
diff --git a/tests/roman-numeral-tooltip.test.mjs b/tests/roman-numeral-tooltip.test.mjs
